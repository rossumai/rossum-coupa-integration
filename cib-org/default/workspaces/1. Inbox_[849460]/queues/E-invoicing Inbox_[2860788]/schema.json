              {
                "rir_field_names": [],
                "constraints": {
                  "required": false
                },
                "score_threshold": 0.0,
                "default_value": null,
                "category": "datapoint",
                "id": "charge_tax_rate_calculated",
                "label": "Charge Tax Rate (calculated)",
                "hidden": true,
                "type": "number",
                "ui_configuration": {
                  "type": "formula",
                  "edit": "disabled"
                },
                "formula": "tax_rate = 0\n\nif is_set(field.charge_tax_rate):\n    tax_rate = field.charge_tax_rate\nelif is_set(field.charge_tax) and is_set(field.charge_amount) and (field.charge_amount - field.charge_tax) != 0:\n    tax_rate = (field.charge_tax / (field.charge_amount - field.charge_tax)) * 100\nelif is_set(field.tax_rate_calculated):\n    tax_rate = field.tax_rate_calculated\n\nsign = field.credit_notes_amounts\nif field.document_type == 'credit_note':\n    if sign == 'negative':\n        -abs(tax_rate)\n    else:\n        abs(tax_rate)\nelse:\n    tax_rate",
                "format": "#,##0.#"
              }
            ]
