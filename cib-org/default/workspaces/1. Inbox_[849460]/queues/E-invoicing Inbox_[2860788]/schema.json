                "format": "#,##0.#"
              },
              {
                "rir_field_names": [],
                "constraints": {
                  "required": false
                },
                "score_threshold": 0.0,
                "default_value": null,
                "category": "datapoint",
                "id": "charge_tax_calculated",
                "label": "Charge Tax Amount (calculated)",
                "hidden": true,
                "type": "number",
                "ui_configuration": {
                  "type": "formula",
                  "edit": "disabled"
                },
                "formula": "tax_amount = 0\n\nif is_set(field.charge_tax):\n    tax_amount = field.charge_tax\nelif is_set(field.charge_amount) and is_set(field.charge_tax_rate_calculated):\n    tax_amount = field.charge_amount * (field.charge_tax_rate_calculated / 100)\n\nsign = field.credit_notes_amounts\nif field.document_type == 'credit_note':\n    if sign == 'negative':  \n        -abs(tax_amount)\n    else:\n        -abs(tax_amount)\nelse:\n    tax_amount",
                "format": "#,##0.#"
              },
              {
                "rir_field_names": [],
                "constraints": {
                  "required": false
                },
                "default_value": null,
                "category": "datapoint",
                "id": "charge_tax_rate",
                "label": "Charge Tax Rate",
                "type": "number",
